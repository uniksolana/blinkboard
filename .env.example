# --- Supabase (solo se usa desde el servidor) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# La anon key ya no es necesaria: el navegador no accede directamente a la base de datos

# --- Privy (login con X y wallets) ---
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
# Dashboard de Privy > Configuration > App settings
PRIVY_APP_SECRET=your_privy_app_secret
# Clave pública PEM. En una sola línea se pueden usar \n
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- Solana ---
# devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# RPC para el navegador (wallet adapter)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# RPC privado para el servidor (p. ej. Helius con API key). Si no se define se usa el público
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=your_helius_key
# Opcional: por defecto se usa el USDC oficial de Circle de la red elegida
# USDC_MINT_ADDRESS=

# Comisión de la plataforma (opcional). 500 = 5 %. Sin wallet de tesorería no se cobra comisión
PLATFORM_FEE_BPS=0
SOLANA_TREASURY_WALLET=

# --- Webhook de Helius ---
# Pon este mismo valor en el campo "Auth Header" del webhook en Helius
HELIUS_WEBHOOK_SECRET=generate_a_long_random_string

# --- Vercel Cron ---
CRON_SECRET=generate_a_long_random_string

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
